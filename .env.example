# Copy to .env and fill in real values. .env is gitignored — never commit it.
# PLACEHOLDERS ONLY in this file (the repo is public).

# --- Jira (Data Center) ---
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=your-jira-username
JIRA_USER_KEY=JIRAUSER00000
JIRA_PAT=your-personal-access-token

# --- Teams ---
TEAMS_WEBHOOK_URL=https://your-power-automate-webhook-url

# Optional tuning vars (defaults in src/config.py):
# LOOKBACK_MINUTES, PRUNE_DAYS, COMMENTS_PER_ISSUE, SNIPPET_CHARS, MAX_CARDS_PER_CYCLE
